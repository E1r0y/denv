# shellcheck shell=bash
# Bash 3.2+ completion, also usable without bash-completion installed.
_denv_completions() {
  local cur="${COMP_WORDS[COMP_CWORD]}" prev="" cmd=init
  local token candidate i=1 separator=false target_seen=false explicit=false
  local backends="auto uv poetry pipenv pdm hatch conda pixi venv"
  local options="--no-color -h --help -v --version"
  COMPREPLY=()
  if (( COMP_CWORD > 0 )); then prev="${COMP_WORDS[COMP_CWORD-1]}"; fi
  while (( i < COMP_CWORD )); do
    token="${COMP_WORDS[i]}"
    if [[ "$separator" == true ]]; then target_seen=true
    else
      case "$token" in
        --) separator=true ;;
        --no-color) ;;
        -b|--backend) i=$((i + 1)) ;;
        init|status|clean)
          if [[ "$explicit" == false && "$target_seen" == false ]]; then cmd="$token"; explicit=true
          else target_seen=true; fi ;;
        -*) ;;
        *) target_seen=true ;;
      esac
    fi
    i=$((i + 1))
  done
  if [[ "$separator" == false && "$cmd" == init && ( "$prev" == -b || "$prev" == --backend ) ]]; then
    while IFS= read -r candidate; do COMPREPLY+=("$candidate"); done < <(compgen -W "$backends" -- "$cur")
    return 0
  fi
  case "$cmd" in
    init) options="$options -b --backend -f --force -n --no-create -g --git-exclude --no-allow" ;;
    status) options="$options -q --quiet" ;;
  esac
  if [[ "$separator" == false && "$cur" == -* ]]; then
    while IFS= read -r candidate; do COMPREPLY+=("$candidate"); done < <(compgen -W "$options" -- "$cur")
  elif [[ "$target_seen" == false ]]; then
    if [[ "$separator" == false && "$explicit" == false ]]; then
      while IFS= read -r candidate; do COMPREPLY+=("$candidate"); done < <(compgen -W 'init status clean' -- "$cur")
    fi
    while IFS= read -r candidate; do COMPREPLY+=("$candidate"); done < <(compgen -d -- "$cur")
  fi
  return 0
}
complete -F _denv_completions -o filenames -o default denv
