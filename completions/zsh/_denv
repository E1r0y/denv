#compdef denv

_denv_target() {
  if [[ "$explicit" == false && "$words[CURRENT]" != */* ]]; then
    local -a commands=(
      'init:Bootstrap workspace configuration'
      'status:Check workspace readiness'
      'clean:Remove denv configuration'
    )
    _describe command commands
  fi
  _files -/
}

_denv() {
  local command=init explicit=false index=2
  local -a args backends
  backends=(auto uv poetry pipenv pdm hatch conda pixi venv)
  while [[ "$words[index]" == --no-color ]] && (( index < CURRENT )); do
    (( index++ ))
  done
  if (( index < CURRENT )); then
    case "$words[index]" in
      init|status|clean)
        command="$words[index]"
        explicit=true
        words=("${(@)words[1,index-1]}" "${(@)words[index+1,-1]}")
        (( CURRENT-- ))
        ;;
    esac
  fi
  args=(
    '--no-color[Disable ANSI color output]'
    '(-h --help)'{-h,--help}'[Print help]'
    '(-v --version)'{-v,--version}'[Print version]'
    '::workspace directory:_denv_target'
  )
  case "$command" in
    init)
      args+=(
        '(-b --backend)'{-b,--backend}'[Select environment backend]:backend:($backends)'
        '(-f --force)'{-f,--force}'[Regenerate the denv block]'
        '(-n --no-create)'{-n,--no-create}'[Do not create environments]'
        '(-g --git-exclude)'{-g,--git-exclude}'[Exclude local artifacts from Git]'
        '--no-allow[Write configuration without authorizing it]'
      ) ;;
    status) args+=('(-q --quiet)'{-q,--quiet}'[Return readiness without output]') ;;
  esac
  _arguments -s "${args[@]}"
}

_denv "$@"
