#!/usr/bin/env bash
#
# denv - Universal direnv workspace bootstrapper for Python ecosystems
# Supports: uv, poetry, pipenv, pdm, hatch, conda/mamba, pixi, venv
#

set -Eeuo pipefail

readonly SCRIPT_NAME="${0##*/}"
readonly VERSION="1.3.0"

# Standard Exit Codes (sysexits.h)
readonly EX_OK=0
readonly EX_ERR=1
readonly EX_USAGE=2
readonly EX_NO_PERM=77
readonly EX_CMD_NOT_FOUND=127

readonly VALID_BACKENDS="auto uv poetry pipenv pdm hatch conda pixi venv"
readonly DENV_START_MARKER="# >>> denv initialize >>>"
readonly DENV_END_MARKER="# <<< denv initialize <<<"
readonly LOCK_STALE_MINUTES=10

# Internal state variables (strictly lowercase)
temp_file=""
lock_dir=""
target_dir=""
venv_to_cleanup=""
venv_creation_in_progress=false
activation_snippet=""

# --- Terminal Capabilities & Styling ---

stderr_color=false
stdout_color=false

init_colors() {
  local mode="${1:-auto}"

  stderr_color=false
  stdout_color=false

  if [[ "$mode" == "never" ]] || [[ -n "${NO_COLOR:-}" ]] || [[ "${TERM:-}" == "dumb" ]]; then
    return 0
  fi

  if [[ "$mode" == "always" ]] || [[ -t 2 ]]; then
    stderr_color=true
  fi

  if [[ "$mode" == "always" ]] || [[ -t 1 ]]; then
    stdout_color=true
  fi
}

log_info() {
  if [[ "$stderr_color" == true ]]; then
    printf '\033[34m[INFO]\033[0m  %s\n' "$*" >&2
  else
    printf '[INFO]  %s\n' "$*" >&2
  fi
}

log_success() {
  if [[ "$stderr_color" == true ]]; then
    printf '\033[32m[OK]\033[0m    %s\n' "$*" >&2
  else
    printf '[OK]    %s\n' "$*" >&2
  fi
}

log_warn() {
  if [[ "$stderr_color" == true ]]; then
    printf '\033[33m[WARN]\033[0m  %s\n' "$*" >&2
  else
    printf '[WARN]  %s\n' "$*" >&2
  fi
}

log_error() {
  if [[ "$stderr_color" == true ]]; then
    printf '\033[31m[ERROR]\033[0m %s\n' "$*" >&2
  else
    printf '[ERROR] %s\n' "$*" >&2
  fi
}

# --- Resource Cleanup & Signal Traps ---

cleanup_resources() {
  if [[ -n "$temp_file" ]] && [[ -e "$temp_file" ]]; then
    rm -f -- "$temp_file"
    temp_file=""
  fi

  if [[ "$venv_creation_in_progress" == true ]] && [[ -n "$venv_to_cleanup" ]] && [[ -d "$venv_to_cleanup" ]]; then
    log_warn "Interrupted during initialization. Purging incomplete environment '${venv_to_cleanup}'..."
    rm -rf -- "$venv_to_cleanup"
    venv_to_cleanup=""
  fi

  if [[ -n "$lock_dir" ]] && [[ -d "$lock_dir" ]]; then
    if [[ -f "${lock_dir}/pid" ]]; then
      local lock_pid
      lock_pid="$(cat "${lock_dir}/pid" 2>/dev/null || true)"
      if [[ "$lock_pid" == "$$" ]]; then
        rm -rf -- "$lock_dir" 2>/dev/null || true
      fi
    else
      rmdir -- "$lock_dir" 2>/dev/null || true
    fi
    lock_dir=""
  fi
}

handle_signal() {
  local sig="$1"
  trap - EXIT INT TERM HUP ERR
  cleanup_resources
  kill -s "$sig" "$$"
}

cleanup() {
  local exit_code=$?
  trap - EXIT INT TERM HUP ERR
  cleanup_resources
  exit "$exit_code"
}

on_error() {
  local exit_code=$?
  if [[ -n "${DENV_DEBUG:-}" ]]; then
    log_error "Unexpected failure at ${BASH_SOURCE[1]:-unknown}:${BASH_LINENO[0]:-?} (exit code: ${exit_code})."
  fi
}

trap cleanup EXIT
trap 'handle_signal INT' INT
trap 'handle_signal TERM' TERM
trap 'handle_signal HUP' HUP
trap on_error ERR

# --- Usage & Help ---

usage_global() {
  local b="" r=""
  if [[ "$stdout_color" == true ]]; then
    b=$'\033[1m'; r=$'\033[0m'
  fi

  cat <<EOF
${b}${SCRIPT_NAME}${r} v${VERSION} - Universal direnv bootstrapper for Python

${b}USAGE:${r}
    ${SCRIPT_NAME} [COMMAND] [OPTIONS] [TARGET_DIR]

${b}COMMANDS:${r}
    init      Bootstrap workspace configuration (default)
    status    Show current workspace state
    clean     Remove denv configuration from workspace

${b}GLOBAL OPTIONS:${r}
        --no-color        Disable ANSI color output
    -h, --help            Print this help message
    -v, --version         Print version information

Run '${SCRIPT_NAME} COMMAND --help' for more information on a specific command.
EOF
}

usage_init() {
  local target="${1:-stdout}"
  local b="" r=""
  if { [[ "$target" == "stdout" ]] && [[ "$stdout_color" == true ]]; } \
  || { [[ "$target" == "stderr" ]] && [[ "$stderr_color" == true ]]; }; then
    b=$'\033[1m'; r=$'\033[0m'
  fi

  cat <<EOF
${b}${SCRIPT_NAME} init${r} - Bootstrap workspace configuration

${b}USAGE:${r}
    ${SCRIPT_NAME} [init] [OPTIONS] [--] [TARGET_DIR]

${b}OPTIONS:${r}
    -b, --backend <NAME>  Environment backend: auto, uv, poetry, pipenv, pdm,
                          hatch, conda, pixi, venv (default: auto)
    -f, --force           Regenerate or replace denv block in .envrc
    -n, --no-create       Do not create virtual environment if missing
    -g, --git-exclude     Hide .envrc and local virtual environments in .git/info/exclude
        --no-color        Disable ANSI color output
    -h, --help            Print this help message and exit

${b}ARGUMENTS:${r}
    TARGET_DIR            Workspace directory (default: current directory '.')

${b}ENVIRONMENT VARIABLES:${r}
    DENV_ALLOW_ROOT       Set to 1 to bypass safety check when running as UID 0
    DENV_DEBUG            Set to 1 for verbose error diagnostics
    NO_COLOR              Disable colored logging if non-empty
EOF
}

usage_status() {
  local b="" r=""
  if [[ "$stdout_color" == true ]]; then
    b=$'\033[1m'; r=$'\033[0m'
  fi

  cat <<EOF
${b}${SCRIPT_NAME} status${r} - Show current workspace state

${b}USAGE:${r}
    ${SCRIPT_NAME} status [OPTIONS] [TARGET_DIR]

${b}OPTIONS:${r}
    -q, --quiet           Suppress output; exit 0 if configured, 1 otherwise
        --no-color        Disable ANSI color output
    -h, --help            Print this help message and exit
EOF
}

usage_clean() {
  local b="" r=""
  if [[ "$stdout_color" == true ]]; then
    b=$'\033[1m'; r=$'\033[0m'
  fi

  cat <<EOF
${b}${SCRIPT_NAME} clean${r} - Remove denv configuration from workspace

${b}USAGE:${r}
    ${SCRIPT_NAME} clean [OPTIONS] [TARGET_DIR]

${b}OPTIONS:${r}
        --no-color        Disable ANSI color output
    -h, --help            Print this help message and exit

Removes the managed denv block from .envrc (preserving custom content),
revokes direnv authorization, and cleans up stale lock files. Does NOT
delete virtual environments.
EOF
}

# --- Core Validation Helpers ---

require_cmd() {
  local cmd="$1"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    log_error "Required tool '${cmd}' is not installed or not available in PATH."
    exit "$EX_CMD_NOT_FOUND"
  fi
}

validate_backend() {
  local backend="$1"
  local valid
  for valid in $VALID_BACKENDS; do
    [[ "$backend" == "$valid" ]] && return 0
  done
  log_error "Invalid backend '${backend}'. Valid options: ${VALID_BACKENDS// /, }."
  exit "$EX_USAGE"
}

acquire_lock() {
  local dir="$1"
  lock_dir="${dir}/.denv.lock"

  if ! mkdir -- "$lock_dir" 2>/dev/null; then
    local stale=false
    local existing_pid=""
    if [[ -f "${lock_dir}/pid" ]]; then
      existing_pid="$(cat "${lock_dir}/pid" 2>/dev/null || true)"
      if [[ -z "$existing_pid" ]] || ! kill -0 "$existing_pid" 2>/dev/null; then
        stale=true
      fi
    else
      # Lock dir exists without a pid file (interrupted before pid write)
      stale=true
    fi

    if [[ "$stale" == true ]]; then
      log_warn "Removing stale workspace lock from PID ${existing_pid:-unknown}."
      rm -rf -- "$lock_dir"
      if ! mkdir -- "$lock_dir" 2>/dev/null; then
        log_error "Failed to acquire lock at '${lock_dir}'."
        exit "$EX_ERR"
      fi
    else
      # Lock is held by a live process — check age and warn if old
      if [[ -n "$existing_pid" ]]; then
        if find "$lock_dir" -maxdepth 0 -mmin +"$LOCK_STALE_MINUTES" -print -quit 2>/dev/null | grep -q .; then
          log_warn "Lock held by PID ${existing_pid} for over ${LOCK_STALE_MINUTES} minutes (may be stuck)."
        fi
      fi
      log_error "Workspace is currently locked by another denv process (lock: '${lock_dir}')."
      log_error "If stale, remove '${lock_dir}' and retry."
      exit "$EX_ERR"
    fi
  fi

  printf '%s\n' "$$" > "${lock_dir}/pid"
}

resolve_target_dir() {
  local raw="${1:-.}"
  if [[ ! -d "$raw" ]]; then
    log_error "Target directory '${raw}' does not exist."
    exit "$EX_NO_PERM"
  fi
  cd -P -- "$raw" && pwd -P
}

# --- Detection & Resolution Logic ---

detect_backend() {
  local dir="$1"

  # 1. Existing local virtual environments take immediate priority
  if [[ -f "${dir}/.venv/bin/activate" ]] || [[ -f "${dir}/venv/bin/activate" ]]; then
    printf 'local-existing\n'
    return 0
  fi

  # 2. Lockfiles & explicit tool configs
  if [[ -f "${dir}/uv.lock" ]]; then
    printf 'uv\n'
  elif [[ -f "${dir}/poetry.lock" ]]; then
    printf 'poetry\n'
  elif [[ -f "${dir}/Pipfile" ]] || [[ -f "${dir}/Pipfile.lock" ]]; then
    printf 'pipenv\n'
  elif [[ -f "${dir}/pdm.lock" ]]; then
    printf 'pdm\n'
  elif [[ -f "${dir}/pixi.toml" ]] || [[ -f "${dir}/pixi.lock" ]]; then
    printf 'pixi\n'
  elif [[ -f "${dir}/hatch.toml" ]]; then
    printf 'hatch\n'
  elif [[ -f "${dir}/environment.yml" ]] || [[ -f "${dir}/environment.yaml" ]] || [[ -d "${dir}/.conda" ]]; then
    printf 'conda\n'
  elif [[ -f "${dir}/pyproject.toml" ]]; then
    if grep -Eq '^[[:space:]]*\[tool\.poetry\]' "${dir}/pyproject.toml"; then
      printf 'poetry\n'
    elif grep -Eq '^[[:space:]]*\[tool\.pdm\]' "${dir}/pyproject.toml"; then
      printf 'pdm\n'
    elif grep -Eq '^[[:space:]]*\[tool\.hatch\]' "${dir}/pyproject.toml"; then
      printf 'hatch\n'
    elif command -v uv >/dev/null 2>&1; then
      printf 'uv\n'
    else
      printf 'venv\n'
    fi
  elif command -v uv >/dev/null 2>&1; then
    printf 'uv\n'
  else
    printf 'venv\n'
  fi
}

detect_backend_source() {
  local dir="$1"
  if [[ -f "${dir}/.venv/bin/activate" ]] || [[ -f "${dir}/venv/bin/activate" ]]; then
    printf 'existing virtualenv\n'
  elif [[ -f "${dir}/uv.lock" ]]; then
    printf 'uv.lock\n'
  elif [[ -f "${dir}/poetry.lock" ]]; then
    printf 'poetry.lock\n'
  elif [[ -f "${dir}/Pipfile" ]] || [[ -f "${dir}/Pipfile.lock" ]]; then
    printf 'Pipfile\n'
  elif [[ -f "${dir}/pdm.lock" ]]; then
    printf 'pdm.lock\n'
  elif [[ -f "${dir}/pixi.toml" ]] || [[ -f "${dir}/pixi.lock" ]]; then
    printf 'pixi.toml\n'
  elif [[ -f "${dir}/hatch.toml" ]]; then
    printf 'hatch.toml\n'
  elif [[ -f "${dir}/environment.yml" ]] || [[ -f "${dir}/environment.yaml" ]] || [[ -d "${dir}/.conda" ]]; then
    printf 'environment.yml\n'
  elif [[ -f "${dir}/pyproject.toml" ]]; then
    printf 'pyproject.toml\n'
  else
    printf 'fallback\n'
  fi
}

read_python_version() {
  local dir="$1"
  if [[ ! -f "${dir}/.python-version" ]]; then
    return 1
  fi
  local raw_ver
  raw_ver="$(grep -v '^[[:space:]]*#' "${dir}/.python-version" 2>/dev/null | grep -v '^[[:space:]]*$' | head -n 1 | tr -d '[:space:]' || true)"
  if [[ -n "$raw_ver" ]]; then
    if [[ "$raw_ver" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
      printf '%s\n' "$raw_ver"
      return 0
    else
      log_warn "Ignoring invalid Python version '${raw_ver}' in .python-version."
      return 1
    fi
  fi
  return 1
}

build_activation_snippet() {
  local dir="$1"
  local backend="$2"
  local no_create="$3"
  local venv_path=""
  local py_version=""

  activation_snippet=""
  py_version="$(read_python_version "$dir" || true)"

  if [[ "$backend" == "auto" ]]; then
    backend="$(detect_backend "$dir")"
    log_info "Auto-detected environment backend: '${backend}'."
  fi

  case "$backend" in
    local-existing)
      if [[ -f "${dir}/.venv/bin/activate" ]]; then
        venv_path="${dir}/.venv"
      else
        venv_path="${dir}/venv"
      fi
      ;;

    uv)
      require_cmd uv
      venv_path="${dir}/.venv"
      if [[ ! -f "${venv_path}/bin/activate" ]]; then
        if [[ "$no_create" == true ]]; then
          log_warn "Skipping 'uv' environment creation (--no-create)."
        else
          local pre_existing=false
          [[ -e "$venv_path" ]] && pre_existing=true

          log_info "Creating virtual environment at '${venv_path}' via 'uv'..."
          [[ "$pre_existing" == false ]] && venv_to_cleanup="$venv_path"
          venv_creation_in_progress=true

          if [[ -n "$py_version" ]]; then
            (cd -- "$dir" && uv venv --python "$py_version" "$venv_path" >&2)
          else
            (cd -- "$dir" && uv venv "$venv_path" >&2)
          fi

          venv_creation_in_progress=false
          venv_to_cleanup=""
        fi
      fi
      ;;

    venv)
      local py_bin="python3"
      if [[ -n "$py_version" ]] && command -v "python${py_version}" >/dev/null 2>&1; then
        py_bin="python${py_version}"
      else
        require_cmd python3
      fi
      venv_path="${dir}/.venv"
      if [[ ! -f "${venv_path}/bin/activate" ]]; then
        if [[ "$no_create" == true ]]; then
          log_warn "Skipping 'venv' environment creation (--no-create)."
        else
          local pre_existing=false
          [[ -e "$venv_path" ]] && pre_existing=true

          log_info "Creating virtual environment at '${venv_path}' via '${py_bin} -m venv'..."
          [[ "$pre_existing" == false ]] && venv_to_cleanup="$venv_path"
          venv_creation_in_progress=true

          (cd -- "$dir" && "$py_bin" -m venv "$venv_path" >&2)

          venv_creation_in_progress=false
          venv_to_cleanup=""
        fi
      fi
      ;;

    poetry)
      require_cmd poetry
      local raw_poetry_path
      raw_poetry_path="$(cd -- "$dir" && poetry env info --path 2>/dev/null || true)"
      venv_path="$(printf '%s\n' "$raw_poetry_path" | tail -n 1 | tr -d '\r\n')"

      if [[ -z "$venv_path" ]] || [[ ! -d "$venv_path" ]]; then
        if [[ "$no_create" == true ]]; then
          log_warn "Poetry environment uninitialized; falling back to dynamic 'layout poetry'."
          activation_snippet="layout poetry"
          return 0
        fi
        log_info "Initializing Poetry environment..."
        (cd -- "$dir" && poetry env use "${py_version:-python3}" >&2)
        raw_poetry_path="$(cd -- "$dir" && poetry env info --path 2>/dev/null || true)"
        venv_path="$(printf '%s\n' "$raw_poetry_path" | tail -n 1 | tr -d '\r\n')"
      fi
      ;;

    pipenv)
      require_cmd pipenv
      local raw_pipenv_path
      raw_pipenv_path="$(cd -- "$dir" && PIPENV_IGNORE_VIRTUALENVS=1 pipenv --venv 2>/dev/null || true)"
      venv_path="$(printf '%s\n' "$raw_pipenv_path" | tail -n 1 | tr -d '\r\n')"

      if [[ -z "$venv_path" ]] || [[ ! -d "$venv_path" ]]; then
        if [[ "$no_create" == true ]]; then
          log_warn "Pipenv environment uninitialized; falling back to dynamic 'layout pipenv'."
          activation_snippet="layout pipenv"
          return 0
        fi
        log_info "Initializing Pipenv environment..."
        (cd -- "$dir" && PIPENV_IGNORE_VIRTUALENVS=1 pipenv --python "${py_version:-python3}" >&2)
        raw_pipenv_path="$(cd -- "$dir" && PIPENV_IGNORE_VIRTUALENVS=1 pipenv --venv 2>/dev/null || true)"
        venv_path="$(printf '%s\n' "$raw_pipenv_path" | tail -n 1 | tr -d '\r\n')"
      fi
      ;;

    pdm)
      require_cmd pdm
      local raw_pdm_path
      raw_pdm_path="$(cd -- "$dir" && pdm info --venv 2>/dev/null || true)"
      venv_path="$(printf '%s\n' "$raw_pdm_path" | tail -n 1 | tr -d '\r\n')"

      if [[ -z "$venv_path" ]] || [[ ! -d "$venv_path" ]]; then
        if [[ "$no_create" == true ]]; then
          venv_path="${dir}/.venv"
        else
          log_info "Creating PDM virtual environment..."
          (cd -- "$dir" && pdm venv create "${py_version:-python3}" >&2)
          raw_pdm_path="$(cd -- "$dir" && pdm info --venv 2>/dev/null || true)"
          venv_path="$(printf '%s\n' "$raw_pdm_path" | tail -n 1 | tr -d '\r\n')"
        fi
      fi
      ;;

    hatch)
      require_cmd hatch
      local raw_hatch_path
      raw_hatch_path="$(cd -- "$dir" && hatch env find default 2>/dev/null || true)"
      venv_path="$(printf '%s\n' "$raw_hatch_path" | tail -n 1 | tr -d '\r\n')"

      if [[ -z "$venv_path" ]] || [[ ! -d "$venv_path" ]]; then
        if [[ "$no_create" == true ]]; then
          log_error "Hatch default environment missing and --no-create was specified."
          exit "$EX_ERR"
        fi
        log_info "Creating Hatch 'default' environment..."
        (cd -- "$dir" && hatch env create default >&2)
        raw_hatch_path="$(cd -- "$dir" && hatch env find default 2>/dev/null || true)"
        venv_path="$(printf '%s\n' "$raw_hatch_path" | tail -n 1 | tr -d '\r\n')"
      fi
      ;;

    pixi)
      require_cmd pixi
      if [[ "$no_create" == false ]] && [[ ! -d "${dir}/.pixi" ]]; then
        log_info "Initializing Pixi environment..."
        (cd -- "$dir" && pixi install >&2)
      fi
      activation_snippet=$(cat <<'SNIPPET'
watch_file pixi.lock
eval "$(pixi shell-hook --shell bash)"
SNIPPET
)
      return 0
      ;;

    conda)
      local conda_bin=""
      if command -v micromamba >/dev/null 2>&1; then
        conda_bin="micromamba"
      elif command -v mamba >/dev/null 2>&1; then
        conda_bin="mamba"
      elif command -v conda >/dev/null 2>&1; then
        conda_bin="conda"
      else
        log_error "Neither 'micromamba', 'mamba', nor 'conda' found in PATH."
        exit "$EX_CMD_NOT_FOUND"
      fi

      local conda_target="${dir}/.conda"
      local env_file=""
      if [[ -f "${dir}/environment.yml" ]]; then
        env_file="${dir}/environment.yml"
      elif [[ -f "${dir}/environment.yaml" ]]; then
        env_file="${dir}/environment.yaml"
      fi

      if [[ -n "$env_file" ]]; then
        local raw_name
        raw_name="$(awk -F: '/^[[:space:]]*name[[:space:]]*:/ {
          sub(/[[:space:]]*#.*$/, "", $2);
          gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2);
          gsub(/^["\x27]|["\x27]$/, "", $2);
          print $2;
          exit
        }' "$env_file")"
        if [[ -n "$raw_name" ]]; then
          if [[ "$raw_name" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
            conda_target="$raw_name"
          else
            log_warn "Conda environment name '${raw_name}' in '${env_file}' contains invalid characters."
          fi
        fi
      fi

      local safe_bin safe_target
      safe_bin="$(printf '%q' "$conda_bin")"
      safe_target="$(printf '%q' "$conda_target")"

      activation_snippet=$(cat <<SNIPPET
eval "\$(${safe_bin} shell hook --shell bash 2>/dev/null || ${safe_bin} shell.bash hook)"
${safe_bin} activate ${safe_target}
SNIPPET
)
      return 0
      ;;

    *)
      log_error "Unsupported backend '${backend}'. Choose from: ${VALID_BACKENDS// /, }."
      exit "$EX_USAGE"
      ;;
  esac

  if [[ -z "$venv_path" ]]; then
    log_error "Failed to resolve virtual environment path for backend '${backend}'."
    exit "$EX_ERR"
  fi

  local act_script="${venv_path}/bin/activate"
  local safe_act
  safe_act="$(printf '%q' "$act_script")"

  # Support in-tree relative fallback for portable workspace movement
  if [[ "$venv_path" == "${dir}/.venv" ]]; then
    activation_snippet=$(cat <<SNIPPET
if [[ -f .venv/bin/activate ]]; then
  source .venv/bin/activate
elif [[ -f ${safe_act} ]]; then
  source ${safe_act}
fi
SNIPPET
)
  elif [[ "$venv_path" == "${dir}/venv" ]]; then
    activation_snippet=$(cat <<SNIPPET
if [[ -f venv/bin/activate ]]; then
  source venv/bin/activate
elif [[ -f ${safe_act} ]]; then
  source ${safe_act}
fi
SNIPPET
)
  else
    activation_snippet=$(cat <<SNIPPET
if [[ -f ${safe_act} ]]; then
  source ${safe_act}
fi
SNIPPET
)
  fi
}

# --- Atomic File Operations ---

apply_to_envrc() {
  local envrc_file="$1"
  local snippet="$2"
  local workspace_dir="$3"
  local force="$4"

  local full_block
  full_block=$(cat <<BLOCK
${DENV_START_MARKER}
# Managed by denv v${VERSION}
watch_file .env
dotenv_if_exists .env
${snippet}
${DENV_END_MARKER}
BLOCK
)

  temp_file="$(mktemp "${workspace_dir}/.envrc.tmp.XXXXXXXXXX")"

  if [[ ! -e "$envrc_file" ]]; then
    printf '%s\n' "$full_block" > "$temp_file"
    mv -f -- "$temp_file" "$envrc_file"
    temp_file=""
    log_success "Created '${envrc_file}'."
    return 0
  fi

  # Check if managed denv block is already present
  if grep -Fq "$DENV_START_MARKER" "$envrc_file" 2>/dev/null; then
    if [[ "$force" == true ]]; then
      DENV_REPL="$full_block" awk -v start="$DENV_START_MARKER" -v end="$DENV_END_MARKER" '
        $0 == start { print ENVIRON["DENV_REPL"]; skip=1; next }
        $0 == end   { skip=0; next }
        !skip       { print }
      ' "$envrc_file" > "$temp_file"
      mv -f -- "$temp_file" "$envrc_file"
      temp_file=""
      log_success "Updated existing denv block in '${envrc_file}'."
    else
      log_info "Workspace is already configured by denv in '${envrc_file}' (use --force to update)."
      rm -f -- "$temp_file"
      temp_file=""
    fi
    return 0
  fi

  # Append block non-destructively to existing .envrc
  cp -p -- "$envrc_file" "$temp_file"
  if [[ -s "$temp_file" && -n "$(tail -c 1 "$temp_file")" ]]; then
    printf '\n' >> "$temp_file"
  fi
  printf '%s\n' "$full_block" >> "$temp_file"

  mv -f -- "$temp_file" "$envrc_file"
  temp_file=""
  log_success "Appended denv block to '${envrc_file}'."
}

remove_denv_block() {
  local envrc_file="$1"

  if ! grep -Fq "$DENV_START_MARKER" "$envrc_file" 2>/dev/null; then
    return 1
  fi

  local workspace_dir
  workspace_dir="$(dirname -- "$envrc_file")"
  temp_file="$(mktemp "${workspace_dir}/.envrc.tmp.XXXXXXXXXX")"

  awk -v start="$DENV_START_MARKER" -v end="$DENV_END_MARKER" '
    $0 == start { skip=1; next }
    $0 == end   { skip=0; next }
    !skip       { print }
  ' "$envrc_file" > "$temp_file"

  # If remaining file is empty or whitespace-only, delete it entirely
  if [[ ! -s "$temp_file" ]] || ! grep -q '[^[:space:]]' "$temp_file" 2>/dev/null; then
    rm -f -- "$temp_file" "$envrc_file"
    temp_file=""
    return 0
  fi

  mv -f -- "$temp_file" "$envrc_file"
  temp_file=""
  return 0
}

exclude_in_git() {
  local workspace_dir="$1"
  local exclude_file=""

  if ! command -v git >/dev/null 2>&1; then
    log_warn "'git' is not installed or available in PATH; skipping --git-exclude."
    return 0
  fi

  if ! git -C "$workspace_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    log_warn "'${workspace_dir}' is not a git repository; skipping --git-exclude."
    return 0
  fi

  local raw_path
  raw_path="$(git -C "$workspace_dir" rev-parse --git-path info/exclude 2>/dev/null || true)"
  if [[ -n "$raw_path" ]]; then
    if [[ "$raw_path" = /* ]]; then
      exclude_file="$raw_path"
    else
      exclude_file="${workspace_dir}/${raw_path}"
    fi
  fi

  if [[ -n "$exclude_file" ]]; then
    local exclude_dir
    exclude_dir="$(dirname -- "$exclude_file")"
    if [[ ! -d "$exclude_dir" ]]; then
      mkdir -p -- "$exclude_dir" 2>/dev/null || true
    fi

    if [[ -d "$exclude_dir" ]] && [[ -w "$exclude_dir" || ( -f "$exclude_file" && -w "$exclude_file" ) ]]; then
      touch -- "$exclude_file"
      if [[ -s "$exclude_file" && -n "$(tail -c 1 "$exclude_file")" ]]; then
        printf '\n' >> "$exclude_file"
      fi
      local pattern
      for pattern in ".envrc" ".envrc.bak" ".envrc.tmp.*" ".denv.lock/" ".venv/" "venv/"; do
        if ! grep -Fxq "$pattern" "$exclude_file" 2>/dev/null; then
          printf '%s\n' "$pattern" >> "$exclude_file"
        fi
      done
      log_success "Registered local artifacts in '${exclude_file}'."
      return 0
    fi
  fi

  log_warn "Git info/exclude is not writable; skipping --git-exclude."
}

# --- Subcommand: init ---

cmd_init() {
  local force=false
  local no_create=false
  local git_exclude=false
  local backend="auto"
  local raw_target=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -b|--backend)
        [[ $# -lt 2 ]] && { log_error "Option '$1' requires an argument."; exit "$EX_USAGE"; }
        backend="$2"
        shift 2
        ;;
      -f|--force)
        force=true
        shift
        ;;
      -n|--no-create)
        no_create=true
        shift
        ;;
      -g|--git-exclude)
        git_exclude=true
        shift
        ;;
      -h|--help)
        usage_init "stdout"
        exit "$EX_OK"
        ;;
      -v|--version)
        printf '%s version %s\n' "$SCRIPT_NAME" "$VERSION"
        exit "$EX_OK"
        ;;
      --)
        shift
        break
        ;;
      -*)
        log_error "Unknown option: $1"
        usage_init "stderr" >&2
        exit "$EX_USAGE"
        ;;
      *)
        if [[ -z "$raw_target" ]]; then
          raw_target="$1"
          shift
        else
          log_error "Unexpected positional argument: $1"
          usage_init "stderr" >&2
          exit "$EX_USAGE"
        fi
        ;;
    esac
  done

  if [[ $# -gt 0 ]] && [[ -z "$raw_target" ]]; then
    raw_target="$1"
    shift
  fi

  if [[ $# -gt 0 ]]; then
    log_error "Unexpected positional argument: $1"
    usage_init "stderr" >&2
    exit "$EX_USAGE"
  fi

  # Validate backend early
  validate_backend "$backend"

  # Resolve target directory
  target_dir="$(resolve_target_dir "${raw_target:-.}")"

  if [[ ! -w "$target_dir" ]]; then
    log_error "Target directory '${target_dir}' is not writable."
    exit "$EX_NO_PERM"
  fi

  # Prevent accidental execution as root
  if [[ "${EUID:-$(id -u)}" -eq 0 ]] && [[ "${DENV_ALLOW_ROOT:-0}" != "1" ]]; then
    log_error "Refusing to run as root (set DENV_ALLOW_ROOT=1 to override)."
    exit "$EX_NO_PERM"
  fi

  require_cmd direnv

  local envrc_file="${target_dir}/.envrc"
  if [[ -L "$envrc_file" ]]; then
    log_error "Refusing to operate on symlinked '${envrc_file}'."
    exit "$EX_NO_PERM"
  fi

  # Acquire workspace mutex lock
  acquire_lock "$target_dir"

  # Build configuration
  build_activation_snippet "$target_dir" "$backend" "$no_create"

  # Write configuration atomically
  apply_to_envrc "$envrc_file" "$activation_snippet" "$target_dir" "$force"

  if [[ "$git_exclude" == true ]]; then
    exclude_in_git "$target_dir"
  fi

  # Grant authorization via direnv
  direnv allow "$envrc_file"
  log_success "Workspace authorized via 'direnv allow'."
}

# --- Subcommand: status ---

cmd_status() {
  local raw_target=""
  local quiet=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -q|--quiet)
        quiet=true
        shift
        ;;
      -h|--help)
        usage_status
        exit "$EX_OK"
        ;;
      -v|--version)
        printf '%s version %s\n' "$SCRIPT_NAME" "$VERSION"
        exit "$EX_OK"
        ;;
      --)
        shift
        break
        ;;
      -*)
        log_error "Unknown option for 'status': $1"
        exit "$EX_USAGE"
        ;;
      *)
        if [[ -z "$raw_target" ]]; then
          raw_target="$1"
          shift
        else
          log_error "Unexpected argument: $1"
          exit "$EX_USAGE"
        fi
        ;;
    esac
  done

  if [[ $# -gt 0 ]] && [[ -z "$raw_target" ]]; then
    raw_target="$1"
    shift
  fi

  if [[ $# -gt 0 ]]; then
    log_error "Unexpected positional argument: $1"
    usage_status >&2
    exit "$EX_USAGE"
  fi

  local dir
  dir="$(resolve_target_dir "${raw_target:-.}")"

  local envrc_file="${dir}/.envrc"
  local has_block=false
  local managed_ver=""

  if [[ -f "$envrc_file" ]] && grep -Fq "$DENV_START_MARKER" "$envrc_file" 2>/dev/null; then
    has_block=true
    managed_ver="$(sed -n 's/^# Managed by denv v\([0-9.]*\).*/\1/p' "$envrc_file" | head -1)"
  fi

  # Quiet mode: just exit code
  if [[ "$quiet" == true ]]; then
    [[ "$has_block" == true ]] && exit "$EX_OK" || exit "$EX_ERR"
  fi

  local backend
  backend="$(detect_backend "$dir")"
  local backend_src
  backend_src="$(detect_backend_source "$dir")"

  local b="" r="" g="" y="" d=""
  if [[ "$stdout_color" == true ]]; then
    b=$'\033[1m'; r=$'\033[0m'; g=$'\033[32m'; y=$'\033[33m'; d=$'\033[2m'
  fi

  printf '\n%sdenv workspace status:%s %s\n\n' "$b" "$r" "$dir"

  # Backend
  printf '  %-20s %s %s(%s)%s\n' "Backend:" "${b}${backend}${r}" "$d" "$backend_src" "$r"

  # Virtual environment
  if [[ -f "${dir}/.venv/bin/activate" ]]; then
    printf '  %-20s %s %s\n' "Virtual env:" ".venv/" "${g}exists${r}"
  elif [[ -f "${dir}/venv/bin/activate" ]]; then
    printf '  %-20s %s %s\n' "Virtual env:" "venv/" "${g}exists${r}"
  else
    printf '  %-20s %s\n' "Virtual env:" "${y}not found${r}"
  fi

  # .envrc
  if [[ ! -e "$envrc_file" ]]; then
    printf '  %-20s %s\n' ".envrc:" "${y}not created${r}"
  elif [[ -L "$envrc_file" ]]; then
    printf '  %-20s %s\n' ".envrc:" "${y}symlink (unsafe)${r}"
  elif [[ "$has_block" == true ]]; then
    printf '  %-20s %s %s\n' ".envrc:" "${g}managed by denv${r}" "${d}v${managed_ver:-unknown}${r}"
  else
    printf '  %-20s %s\n' ".envrc:" "present ${y}(no denv block)${r}"
  fi

  # .env
  if [[ -f "${dir}/.env" ]]; then
    local var_count
    var_count="$(grep -cE '^[A-Za-z_][A-Za-z0-9_]*=' "${dir}/.env" 2>/dev/null || true)"
    var_count="${var_count:-0}"
    printf '  %-20s %s %s\n' ".env:" "${g}present${r}" "${d}(${var_count} variable$([ "$var_count" != 1 ] && echo s))${r}"
  else
    printf '  %-20s %s\n' ".env:" "${d}not present${r}"
  fi

  # .python-version
  local pyver
  if pyver="$(read_python_version "$dir")"; then
    printf '  %-20s %s\n' "Python version:" "${b}${pyver}${r}"
  fi

  # Lock
  if [[ -d "${dir}/.denv.lock" ]]; then
    local lock_pid=""
    [[ -f "${dir}/.denv.lock/pid" ]] && lock_pid="$(cat "${dir}/.denv.lock/pid" 2>/dev/null || true)"
    if [[ -n "$lock_pid" ]] && kill -0 "$lock_pid" 2>/dev/null; then
      printf '  %-20s %s\n' "Lock:" "${y}active (PID ${lock_pid})${r}"
    else
      printf '  %-20s %s\n' "Lock:" "${y}stale (PID ${lock_pid:-unknown})${r}"
    fi
  else
    printf '  %-20s %s\n' "Lock:" "${d}none${r}"
  fi

  printf '\n'

  [[ "$has_block" == true ]] && exit "$EX_OK" || exit "$EX_ERR"
}

# --- Subcommand: clean ---

cmd_clean() {
  local raw_target=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        usage_clean
        exit "$EX_OK"
        ;;
      -v|--version)
        printf '%s version %s\n' "$SCRIPT_NAME" "$VERSION"
        exit "$EX_OK"
        ;;
      --)
        shift
        break
        ;;
      -*)
        log_error "Unknown option for 'clean': $1"
        exit "$EX_USAGE"
        ;;
      *)
        if [[ -z "$raw_target" ]]; then
          raw_target="$1"
          shift
        else
          log_error "Unexpected argument: $1"
          exit "$EX_USAGE"
        fi
        ;;
    esac
  done

  if [[ $# -gt 0 ]] && [[ -z "$raw_target" ]]; then
    raw_target="$1"
    shift
  fi

  if [[ $# -gt 0 ]]; then
    log_error "Unexpected positional argument: $1"
    usage_clean >&2
    exit "$EX_USAGE"
  fi

  local dir
  dir="$(resolve_target_dir "${raw_target:-.}")"

  if [[ ! -w "$dir" ]]; then
    log_error "Directory '${dir}' is not writable."
    exit "$EX_NO_PERM"
  fi

  local envrc_file="${dir}/.envrc"
  local cleaned=false

  # Check symlink or remove denv block from .envrc
  if [[ -L "$envrc_file" ]]; then
    log_warn "Refusing to operate on symlinked '${envrc_file}'."
  elif [[ -f "$envrc_file" ]]; then
    if remove_denv_block "$envrc_file"; then
      if [[ -f "$envrc_file" ]]; then
        log_success "Removed denv block from '${envrc_file}' (custom content preserved)."
      else
        log_success "Removed '${envrc_file}' (was entirely managed by denv)."
      fi
      cleaned=true
    else
      log_info "No denv block found in '${envrc_file}'."
    fi
  else
    log_info "No .envrc file found."
  fi

  # Revoke direnv authorization
  if command -v direnv >/dev/null 2>&1; then
    direnv deny "$dir" 2>/dev/null || true
    if [[ "$cleaned" == true ]]; then
      log_success "Revoked direnv authorization for '${dir}'."
    fi
  fi

  # Clean up stale lock
  if [[ -d "${dir}/.denv.lock" ]]; then
    local lock_pid=""
    [[ -f "${dir}/.denv.lock/pid" ]] && lock_pid="$(cat "${dir}/.denv.lock/pid" 2>/dev/null || true)"
    if [[ -z "$lock_pid" ]] || ! kill -0 "$lock_pid" 2>/dev/null; then
      rm -rf -- "${dir}/.denv.lock"
      log_success "Removed stale lock file."
      cleaned=true
    else
      log_warn "Active lock (PID ${lock_pid}) — not removing."
    fi
  fi

  if [[ "$cleaned" == false ]]; then
    log_info "Workspace is already clean."
  fi
}

# --- CLI Entrypoint ---

main() {
  # Global pre-scan: extract --no-color (respects -- separator)
  local cli_color_mode="auto"
  local filtered_args=()
  local seen_separator=false
  local arg
  for arg in "$@"; do
    if [[ "$seen_separator" == false ]] && [[ "$arg" == "--" ]]; then
      seen_separator=true
      filtered_args+=("$arg")
    elif [[ "$seen_separator" == false ]] && [[ "$arg" == "--no-color" ]]; then
      cli_color_mode="never"
    else
      filtered_args+=("$arg")
    fi
  done

  init_colors "$cli_color_mode"

  if [[ ${#filtered_args[@]} -gt 0 ]]; then
    set -- "${filtered_args[@]}"
  else
    set --
  fi

  # Global --help / --version (before subcommand dispatch)
  case "${1:-}" in
    -h|--help|help)
      usage_global
      exit "$EX_OK"
      ;;
    -v|--version|version)
      printf '%s version %s\n' "$SCRIPT_NAME" "$VERSION"
      exit "$EX_OK"
      ;;
  esac

  # Subcommand dispatch
  local subcommand="init"
  if [[ $# -gt 0 ]] && [[ "$1" != -* ]]; then
    case "$1" in
      init|status|clean)
        subcommand="$1"
        shift
        ;;
    esac
  fi

  "cmd_${subcommand}" "$@"
}

main "$@"
