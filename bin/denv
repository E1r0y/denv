#!/usr/bin/env bash
#
# denv - Universal direnv workspace bootstrapper for Python ecosystems
# Supports: uv, poetry, pipenv, pdm, hatch, conda/mamba, pixi, venv
#

set -Eeuo pipefail

readonly SCRIPT_NAME="${0##*/}"
readonly VERSION="1.4.0"

# CLI exit codes (77 follows sysexits.h; 2 follows shell usage conventions).
readonly EX_OK=0
readonly EX_ERR=1
readonly EX_USAGE=2
readonly EX_NO_PERM=77
readonly EX_CMD_NOT_FOUND=127

readonly VALID_BACKENDS="auto uv poetry pipenv pdm hatch conda pixi venv"
readonly DENV_START_MARKER="# >>> denv initialize >>>"
readonly DENV_END_MARKER="# <<< denv initialize <<<"
readonly MIN_DIRENV_VERSION="2.26.0"

# Internal state variables (strictly lowercase)
temp_file=""
lock_dir=""
lock_acquired=false
recovery_dir=""
target_dir=""
venv_to_cleanup=""
venv_creation_in_progress=false
activation_snippet=""
managed_backend=""
managed_environment=""
detected_backend=""
detected_source=""
envrc_state="absent"

# --- Terminal Capabilities & Styling ---

stderr_color=false
stdout_color=false

init_colors() {
  local mode="${1:-auto}"

  stderr_color=false
  stdout_color=false

  if [[ "$mode" == "never" ]] || [[ -n "${NO_COLOR:-}" ]] || [[ "${TERM:-}" == "dumb" ]]; then
    return 0
  fi

  if [[ "$mode" == "always" ]] || [[ -t 2 ]]; then
    stderr_color=true
  fi

  if [[ "$mode" == "always" ]] || [[ -t 1 ]]; then
    stdout_color=true
  fi
}

log_info() {
  if [[ "$stderr_color" == true ]]; then
    printf '\033[34m[INFO]\033[0m  %s\n' "$*" >&2
  else
    printf '[INFO]  %s\n' "$*" >&2
  fi
}

log_success() {
  if [[ "$stderr_color" == true ]]; then
    printf '\033[32m[OK]\033[0m    %s\n' "$*" >&2
  else
    printf '[OK]    %s\n' "$*" >&2
  fi
}

log_warn() {
  if [[ "$stderr_color" == true ]]; then
    printf '\033[33m[WARN]\033[0m  %s\n' "$*" >&2
  else
    printf '[WARN]  %s\n' "$*" >&2
  fi
}

log_error() {
  if [[ "$stderr_color" == true ]]; then
    printf '\033[31m[ERROR]\033[0m %s\n' "$*" >&2
  else
    printf '[ERROR] %s\n' "$*" >&2
  fi
}

# --- Resource Cleanup & Signal Traps ---

cleanup_resources() {
  if [[ -n "$temp_file" ]] && [[ -e "$temp_file" ]]; then
    rm -f -- "$temp_file"
    temp_file=""
  fi

  if [[ "$venv_creation_in_progress" == true ]] && [[ -n "$venv_to_cleanup" ]] && [[ -d "$venv_to_cleanup" ]]; then
    log_warn "Initialization failed or was interrupted. Removing incomplete environment '${venv_to_cleanup}'..."
    rm -rf -- "$venv_to_cleanup"
    venv_to_cleanup=""
  fi

  if [[ "$lock_acquired" == true ]] && [[ -d "$lock_dir" ]] && [[ ! -L "$lock_dir" ]]; then
    if [[ -f "${lock_dir}/pid" ]]; then
      local lock_pid
      lock_pid="$(cat "${lock_dir}/pid" 2>/dev/null || true)"
      if [[ "$lock_pid" == "$$" ]]; then
        rm -f -- "${lock_dir}/pid" 2>/dev/null || true
        rmdir -- "$lock_dir" 2>/dev/null || true
      fi
    else
      rmdir -- "$lock_dir" 2>/dev/null || true
    fi
    lock_dir=""
    lock_acquired=false
  fi
  if [[ -n "$recovery_dir" ]]; then
    rmdir -- "$recovery_dir" 2>/dev/null || true
    recovery_dir=""
  fi
}

handle_signal() {
  local sig="$1"
  trap - EXIT INT TERM HUP ERR
  cleanup_resources
  kill -s "$sig" "$$"
}

cleanup() {
  local exit_code=$?
  trap - EXIT INT TERM HUP ERR
  cleanup_resources
  exit "$exit_code"
}

on_error() {
  local exit_code=$?
  if [[ "${DENV_DEBUG:-0}" == 1 ]]; then
    log_error "Unexpected failure at ${BASH_SOURCE[1]:-unknown}:${BASH_LINENO[0]:-?} (exit code: ${exit_code})."
  fi
}

trap cleanup EXIT
trap 'handle_signal INT' INT
trap 'handle_signal TERM' TERM
trap 'handle_signal HUP' HUP
trap on_error ERR

# --- Usage & Help ---

usage_global() {
  local b="" r=""
  if [[ "$stdout_color" == true ]]; then
    b=$'\033[1m'; r=$'\033[0m'
  fi

  cat <<EOF
${b}${SCRIPT_NAME}${r} v${VERSION} - Universal direnv bootstrapper for Python

${b}USAGE:${r}
    ${SCRIPT_NAME} [COMMAND] [OPTIONS] [TARGET_DIR]

${b}COMMANDS:${r}
    init      Bootstrap workspace configuration (default)
    status    Show current workspace state
    clean     Remove denv configuration from workspace

${b}GLOBAL OPTIONS:${r}
        --no-color        Disable ANSI color output
    -h, --help            Print this help message
    -v, --version         Print version information

Run '${SCRIPT_NAME} COMMAND --help' for more information on a specific command.
EOF
}

usage_init() {
  local target="${1:-stdout}"
  local b="" r=""
  if { [[ "$target" == "stdout" ]] && [[ "$stdout_color" == true ]]; } \
  || { [[ "$target" == "stderr" ]] && [[ "$stderr_color" == true ]]; }; then
    b=$'\033[1m'; r=$'\033[0m'
  fi

  cat <<EOF
${b}${SCRIPT_NAME} init${r} - Bootstrap workspace configuration

${b}USAGE:${r}
    ${SCRIPT_NAME} [init] [OPTIONS] [--] [TARGET_DIR]

${b}OPTIONS:${r}
    -b, --backend <NAME>  Environment backend: auto, uv, poetry, pipenv, pdm,
                          hatch, conda, pixi, venv (default: auto)
    -f, --force           Regenerate or replace denv block in .envrc
    -n, --no-create       Do not create virtual environment if missing
    -g, --git-exclude     Hide .envrc and local virtual environments in .git/info/exclude
        --no-allow        Write configuration without authorizing it
        --no-color        Disable ANSI color output
    -h, --help            Print this help message and exit

${b}ARGUMENTS:${r}
    TARGET_DIR            Workspace directory (default: current directory '.')

${b}ENVIRONMENT VARIABLES:${r}
    DENV_ALLOW_ROOT       Set to 1 to bypass safety check when running as UID 0
    DENV_DEBUG            Set to 1 for verbose error diagnostics
    NO_COLOR              Disable colored logging if non-empty
EOF
}

usage_status() {
  local b="" r=""
  if [[ "$stdout_color" == true ]]; then
    b=$'\033[1m'; r=$'\033[0m'
  fi

  cat <<EOF
${b}${SCRIPT_NAME} status${r} - Show current workspace state

${b}USAGE:${r}
    ${SCRIPT_NAME} status [OPTIONS] [TARGET_DIR]

${b}OPTIONS:${r}
    -q, --quiet           Exit 0 only if configured, environment exists, and authorized
        --no-color        Disable ANSI color output
    -h, --help            Print this help message and exit
EOF
}

usage_clean() {
  local b="" r=""
  if [[ "$stdout_color" == true ]]; then
    b=$'\033[1m'; r=$'\033[0m'
  fi

  cat <<EOF
${b}${SCRIPT_NAME} clean${r} - Remove denv configuration from workspace

${b}USAGE:${r}
    ${SCRIPT_NAME} clean [OPTIONS] [TARGET_DIR]

${b}OPTIONS:${r}
        --no-color        Disable ANSI color output
    -h, --help            Print this help message and exit

Removes the managed denv block from .envrc (preserving custom content),
revokes direnv authorization, and cleans up stale lock files. Does NOT
delete virtual environments.
EOF
}

# --- Core Validation Helpers ---

require_cmd() {
  local cmd="$1"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    log_error "Required tool '${cmd}' is not installed or not available in PATH."
    exit "$EX_CMD_NOT_FOUND"
  fi
}

validate_backend() {
  local backend="$1"
  local valid
  for valid in $VALID_BACKENDS; do
    [[ "$backend" == "$valid" ]] && return 0
  done
  log_error "Invalid backend '${backend}'. Valid options: ${VALID_BACKENDS// /, }."
  exit "$EX_USAGE"
}

acquire_lock() {
  local dir="$1"
  lock_dir="${dir}/.denv.lock"
  if mkdir -- "$lock_dir" 2>/dev/null; then
    lock_acquired=true
  else
    local existing_pid=""
    if [[ -L "$lock_dir" || ! -d "$lock_dir" || -L "${lock_dir}/pid" ]]; then
      log_error "Unsafe workspace lock '${lock_dir}'; refusing to follow or remove it."
      exit "$EX_NO_PERM"
    fi
    existing_pid="$(cat "${lock_dir}/pid" 2>/dev/null || true)"
    # No PID can mean that another process has just created the directory.
    # Never infer staleness from the window before its PID write completes.
    if [[ ! "$existing_pid" =~ ^[1-9][0-9]*$ ]] || process_is_alive "$existing_pid"; then
      log_error "Workspace is locked or its lock is still being initialized: '${lock_dir}'."
      log_error "For an abandoned lock without a PID, verify no denv is running before removing it manually."
      exit "$EX_ERR"
    fi
    # Serialize stale-lock recovery. A second reaper must never remove the
    # replacement lock installed by the first. Recheck while holding the guard.
    if ! mkdir -- "${lock_dir}.recovery" 2>/dev/null; then
      log_error "Workspace lock recovery is in progress: '${lock_dir}.recovery'."
      exit "$EX_ERR"
    fi
    recovery_dir="${lock_dir}.recovery"
    local current_pid
    current_pid="$(cat "${lock_dir}/pid" 2>/dev/null || true)"
    if [[ "$current_pid" != "$existing_pid" ]] || process_is_alive "$current_pid"; then
      log_error "Workspace lock changed during recovery; retry."
      exit "$EX_ERR"
    fi
    log_warn "Removing stale workspace lock from PID ${existing_pid}."
    rm -f -- "${lock_dir}/pid"
    rmdir -- "$lock_dir" || { log_error "Lock contains unexpected files; inspect it manually."; exit "$EX_ERR"; }
    if ! mkdir -- "$lock_dir" 2>/dev/null; then
      log_error "Another process acquired the workspace lock; retry."
      exit "$EX_ERR"
    fi
    lock_acquired=true
  fi
  printf '%s\n' "$$" > "${lock_dir}/pid"
  if [[ -n "$recovery_dir" ]]; then
    rmdir -- "$recovery_dir"
    recovery_dir=""
  fi
}

process_is_alive() {
  # kill -0 also fails with EPERM, which does not prove that a PID is dead.
  kill -0 "$1" 2>/dev/null || ps -p "$1" -o pid= 2>/dev/null | grep -q '[0-9]'
}

require_direnv() {
  require_cmd direnv
  local version major minor
  version="$(direnv version)"
  if [[ "$version" =~ ^([0-9]+)\.([0-9]+)(\.[0-9]+)?$ ]]; then
    major="${BASH_REMATCH[1]}"; minor="${BASH_REMATCH[2]}"
    if (( major > 2 || (major == 2 && minor >= 26) )); then
      case "$target_dir" in
        *'$'*|*'`'*|*'"'*|*"'"*|*\\*|*$'\n'*|*$'\r'*)
          if (( major == 2 && minor < 38 )); then
            log_error "Workspace paths containing shell syntax require direnv >= 2.38. Upgrade direnv before initializing this path."
            exit "$EX_ERR"
          fi
          ;;
      esac
      return 0
    fi
  fi
  log_error "direnv >= ${MIN_DIRENV_VERSION} is required (found '${version}')."
  exit "$EX_ERR"
}

resolve_target_dir() {
  local raw="${1:-.}"
  if [[ ! -d "$raw" ]]; then
    log_error "Target directory '${raw}' does not exist."
    exit "$EX_NO_PERM"
  fi
  cd -P -- "$raw" && pwd -P
}

# --- Detection & Resolution Logic ---

detect_workspace() {
  local dir="$1"
  detected_backend=""
  detected_source="fallback"
  if [[ -f "${dir}/.venv/bin/activate" ]] || [[ -f "${dir}/venv/bin/activate" ]]; then
    detected_backend="local-existing"; detected_source="existing virtualenv"
  elif [[ -f "${dir}/uv.lock" ]]; then
    detected_backend="uv"; detected_source="uv.lock"
  elif [[ -f "${dir}/poetry.lock" ]]; then
    detected_backend="poetry"; detected_source="poetry.lock"
  elif [[ -f "${dir}/Pipfile" ]] || [[ -f "${dir}/Pipfile.lock" ]]; then
    detected_backend="pipenv"; detected_source="Pipfile / Pipfile.lock"
  elif [[ -f "${dir}/pdm.lock" ]]; then
    detected_backend="pdm"; detected_source="pdm.lock"
  elif [[ -f "${dir}/pixi.toml" || -f "${dir}/pixi.lock" ]] \
    || { [[ -f "${dir}/pyproject.toml" ]] && grep -Eq '^\[tool\.pixi([.]|\])' "${dir}/pyproject.toml"; }; then
    detected_backend="pixi"; detected_source="pixi.toml / pixi.lock / pyproject.toml"
  elif [[ -f "${dir}/hatch.toml" ]]; then
    detected_backend="hatch"; detected_source="hatch.toml"
  elif [[ -f "${dir}/environment.yml" ]] || [[ -f "${dir}/environment.yaml" ]] || [[ -d "${dir}/.conda" ]]; then
    detected_backend="conda"; detected_source="environment.yml / environment.yaml / .conda"
  elif [[ -f "${dir}/pyproject.toml" ]]; then
    detected_source="pyproject.toml"
    if grep -Eq '^[[:space:]]*\[tool\.poetry(\]|\.)' "${dir}/pyproject.toml"; then
      detected_backend="poetry"
    elif grep -Eq '^[[:space:]]*\[tool\.pdm(\]|\.)' "${dir}/pyproject.toml"; then
      detected_backend="pdm"
    elif grep -Eq '^[[:space:]]*\[tool\.hatch(\]|\.)' "${dir}/pyproject.toml"; then
      detected_backend="hatch"
    fi
  fi
  if [[ -z "$detected_backend" ]]; then
    if command -v uv >/dev/null 2>&1; then detected_backend="uv"; else detected_backend="venv"; fi
  fi
}

read_python_version() {
  local dir="$1"
  if [[ ! -f "${dir}/.python-version" ]]; then
    return 1
  fi
  local raw_ver
  raw_ver="$(grep -v '^[[:space:]]*#' "${dir}/.python-version" 2>/dev/null | grep -v '^[[:space:]]*$' | head -n 1 | tr -d '[:space:]' || true)"
  if [[ -n "$raw_ver" ]]; then
    if [[ "$raw_ver" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
      printf '%s\n' "$raw_ver"
      return 0
    else
      log_warn "Ignoring invalid Python version '${raw_ver}' in .python-version."
      return 1
    fi
  fi
  return 1
}

# Querying an environment must not create it. PDM's selected interpreter is
# recorded in .pdm-python; querying info on an uninitialized project may select
# (and create) an interpreter, so use its read-only venv lookup in that case.
query_venv_path() {
  local dir="$1" backend="$2" interpreter=""
  case "$backend" in
    poetry) (cd -- "$dir" && poetry env info --path) ;;
    pipenv) (cd -- "$dir" && PIPENV_IGNORE_VIRTUALENVS=1 pipenv --venv) ;;
    pdm)
      if [[ -f "${dir}/.pdm-python" ]]; then
        IFS= read -r interpreter <"${dir}/.pdm-python" || [[ -n "$interpreter" ]]
        [[ "$interpreter" = /* ]] || return 1
        dirname -- "$(dirname -- "$interpreter")"
      else
        (cd -- "$dir" && pdm venv --path in-project)
      fi
      ;;
    hatch) (cd -- "$dir" && hatch env find default) ;;
  esac
}

select_python() {
  local requested="$1" candidate actual
  local candidates=(python3)
  if [[ -n "$requested" ]]; then
    if [[ ! "$requested" =~ ^[0-9]+(\.[0-9]+){0,2}$ ]]; then
      log_error "venv requires a numeric Python version; use uv for '${requested}'."
      return 1
    fi
    candidates=("python${requested}" "python${requested%.*}" python3)
  fi
  for candidate in "${candidates[@]}"; do
    command -v "$candidate" >/dev/null 2>&1 || continue
    if [[ -z "$requested" ]]; then printf '%s\n' "$candidate"; return 0; fi
    actual="$("$candidate" -c 'import platform; print(platform.python_version())' 2>/dev/null)" || continue
    if [[ "$actual" == "$requested" || "$actual" == "$requested".* ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  log_error "Requested Python '${requested:-3}' is not available. Install it or select the uv backend."
  return 1
}

begin_local_creation() {
  venv_to_cleanup=""
  if [[ ! -e "$1" && ! -L "$1" ]]; then venv_to_cleanup="$1"; fi
  venv_creation_in_progress=true
}

finish_local_creation() {
  venv_creation_in_progress=false
  venv_to_cleanup=""
}

build_activation_snippet() {
  local dir="$1" backend="$2" no_create="$3"
  local venv_path="" py_version=""
  activation_snippet=""
  managed_environment=""
  py_version="$(read_python_version "$dir" || true)"
  if [[ "$backend" == auto ]]; then
    detect_workspace "$dir"
    backend="$detected_backend"
    log_info "Auto-detected environment backend: '${backend}' (${detected_source})."
  fi
  managed_backend="$backend"
  case "$backend" in
    local-existing)
      if [[ -f "${dir}/.venv/bin/activate" ]]; then venv_path="${dir}/.venv"; else venv_path="${dir}/venv"; fi
      ;;
    uv|venv)
      venv_path="${dir}/.venv"
      if [[ ! -f "${venv_path}/bin/activate" ]]; then
        if [[ "$no_create" == true ]]; then
          log_warn "Environment is missing; writing a pending configuration (--no-create)."
        else
          begin_local_creation "$venv_path"
          log_info "Creating '${venv_path}' with ${backend}..."
          if [[ "$backend" == uv ]]; then
            require_cmd uv
            if [[ -n "$py_version" ]]; then
              (cd -- "$dir" && uv venv --python "$py_version" "$venv_path" >&2) || exit "$?"
            else
              (cd -- "$dir" && uv venv "$venv_path" >&2) || exit "$?"
            fi
          else
            local py_bin
            py_bin="$(select_python "$py_version")"
            (cd -- "$dir" && "$py_bin" -m venv "$venv_path" >&2) || exit "$?"
          fi
          [[ -f "${venv_path}/bin/activate" ]] || { log_error "${backend} did not create a usable virtual environment."; exit "$EX_ERR"; }
          finish_local_creation
        fi
      fi
      ;;
    poetry|pipenv|pdm|hatch)
      require_cmd "$backend"
      venv_path="$(query_venv_path "$dir" "$backend" 2>/dev/null || true)"
      if [[ "$venv_path" != /* || ! -f "${venv_path}/bin/activate" ]]; then
        if [[ "$no_create" == true ]]; then
          log_error "No usable ${backend} environment found; --no-create prevents initialization."
          exit "$EX_ERR"
        fi
        log_info "Initializing ${backend} environment..."
        case "$backend" in
          poetry) (cd -- "$dir" && poetry env use "${py_version:-python3}" >&2) || exit "$?" ;;
          pipenv) (cd -- "$dir" && PIPENV_IGNORE_VIRTUALENVS=1 pipenv --python "${py_version:-python3}" >&2) || exit "$?" ;;
          pdm) (cd -- "$dir" && pdm venv create "${py_version:-python3}" >&2) || exit "$?" ;;
          hatch) (cd -- "$dir" && hatch env create default >&2) || exit "$?" ;;
        esac
        venv_path="$(query_venv_path "$dir" "$backend" 2>/dev/null || true)"
        if [[ "$backend" == pdm && ! -f "${venv_path}/bin/activate" ]]; then
          local interpreter
          interpreter="$(cd -- "$dir" && pdm info --python)"
          venv_path="$(dirname -- "$(dirname -- "$interpreter")")"
        fi
        if [[ "$venv_path" != /* || ! -f "${venv_path}/bin/activate" ]]; then
          log_error "${backend} did not return a usable virtual environment path."
          exit "$EX_ERR"
        fi
      fi
      ;;
    pixi)
      require_cmd pixi
      managed_environment="${dir}/.pixi/envs/default"
      if [[ "$no_create" == false ]]; then
        (cd -- "$dir" && pixi install >&2) || exit "$?"
      elif [[ ! -d "${managed_environment}/conda-meta" ]]; then
        log_error "Pixi default environment is missing and --no-create was specified."
        exit "$EX_ERR"
      fi
      # Capture the hook once, with both installation and lock updates disabled.
      # Changing directories must never install dependencies or launch Pixi.
      local pixi_hook
      pixi_hook="$(cd -- "$dir" && pixi shell-hook --shell bash --frozen --no-install)" || exit "$?"
      [[ -n "$pixi_hook" && -d "${managed_environment}/conda-meta" ]] || { log_error "Pixi did not produce a usable default environment."; exit "$EX_ERR"; }
      activation_snippet="watch_file pixi.toml pyproject.toml pixi.lock
${pixi_hook}"
      return 0
      ;;
    conda)
      local conda_bin="" env_file=""
      if command -v micromamba >/dev/null 2>&1; then conda_bin=micromamba
      elif command -v mamba >/dev/null 2>&1; then conda_bin=mamba
      else require_cmd conda; conda_bin=conda; fi
      managed_environment="${dir}/.conda"
      if [[ ! -d "${managed_environment}/conda-meta" ]]; then
        if [[ "$no_create" == true ]]; then
          log_error "Local Conda environment is missing and --no-create was specified."
          exit "$EX_ERR"
        fi
        if [[ -f "${dir}/environment.yml" ]]; then env_file="${dir}/environment.yml"
        elif [[ -f "${dir}/environment.yaml" ]]; then env_file="${dir}/environment.yaml"
        else log_error "Conda requires environment.yml, environment.yaml, or an existing .conda environment."; exit "$EX_ERR"; fi
        begin_local_creation "$managed_environment"
        if [[ "$conda_bin" == micromamba ]]; then
          (cd -- "$dir" && "$conda_bin" create --yes --prefix "$managed_environment" --file "$env_file" >&2) || exit "$?"
        else
          (cd -- "$dir" && "$conda_bin" env create --yes --prefix "$managed_environment" --file "$env_file" >&2) || exit "$?"
        fi
        [[ -d "${managed_environment}/conda-meta" ]] || { log_error "Conda did not create a usable environment."; exit "$EX_ERR"; }
        finish_local_creation
      fi
      local safe_bin safe_target
      safe_bin="$(printf '%q' "$conda_bin")"
      safe_target="$(printf '%q' "$managed_environment")"
      activation_snippet="watch_file environment.yml environment.yaml
_denv_conda_hook=\"\$(${safe_bin} shell hook --shell bash 2>/dev/null || ${safe_bin} shell.bash hook)\" || return 1
eval \"\$_denv_conda_hook\"
unset _denv_conda_hook
${safe_bin} activate ${safe_target}"
      return 0
      ;;
    *) log_error "Unsupported backend '${backend}'."; exit "$EX_USAGE" ;;
  esac
  managed_environment="$venv_path"
  local safe_act relative_act=""
  safe_act="$(printf '%q' "${venv_path}/bin/activate")"
  case "$venv_path" in
    "${dir}/.venv") relative_act=".venv/bin/activate" ;;
    "${dir}/venv") relative_act="venv/bin/activate" ;;
  esac
  if [[ -n "$relative_act" ]]; then
    activation_snippet="if [[ -f ${relative_act} ]]; then
  source ${relative_act}
elif [[ -f ${safe_act} ]]; then
  source ${safe_act}
else
  log_error 'Virtual environment is missing; run denv init --force.'
  return 1
fi"
  else
    activation_snippet="if [[ -f ${safe_act} ]]; then
  source ${safe_act}
else
  log_error 'Virtual environment is missing; run denv init --force.'
  return 1
fi"
  fi
}

# --- Atomic File Operations ---

# Inspect markers once before any backend or file operation. CRLF markers are
# accepted, while duplicates, orphaned ends and nested/incomplete blocks fail.
inspect_envrc() {
  local file="$1"
  if [[ -L "$file" || ( -e "$file" && ! -f "$file" ) ]]; then
    envrc_state=unsafe
  elif [[ ! -e "$file" ]]; then
    envrc_state=absent
  else
    envrc_state="$(awk -v start="$DENV_START_MARKER" -v end="$DENV_END_MARKER" '
      { line=$0; sub(/\r$/, "", line) }
      line == start { if (opened || count) bad=1; opened=1; count++; next }
      line == end { if (!opened) bad=1; opened=0; next }
      index(line, start) || index(line, end) { bad=1 }
      END { if (bad || opened) print "invalid"; else if (count) print "managed"; else print "custom" }
    ' "$file")" || return 1
  fi
}

validate_envrc_for_write() {
  inspect_envrc "$1"
  case "$envrc_state" in
    unsafe) log_error "Refusing to operate on symlinked or non-regular '$1'."; exit "$EX_NO_PERM" ;;
    invalid) log_error "Invalid denv markers in '$1'. Repair the block before retrying; file left unchanged."; exit "$EX_ERR" ;;
  esac
}

preserve_file_mode() {
  local original="$1" replacement="$2" mode
  mode="$(stat -c '%a' "$original" 2>/dev/null || stat -f '%Lp' "$original")" || return 1
  chmod "$mode" "$replacement"
}

apply_to_envrc() {
  local envrc_file="$1" snippet="$2" workspace_dir="$3" force="$4"
  local full_block environment_hex
  if [[ "$envrc_state" == managed && "$force" == false ]]; then return 0; fi
  environment_hex="$(printf '%s' "$managed_environment" | od -An -tx1 | tr -d ' \n')"
  full_block="${DENV_START_MARKER}
# Managed by denv v${VERSION}
# denv backend: ${managed_backend}
# denv environment: ${environment_hex}
watch_file .env
dotenv_if_exists .env
${snippet}
${DENV_END_MARKER}"
  temp_file="$(mktemp "${workspace_dir}/.envrc.tmp.XXXXXXXXXX")" || return 1
  if [[ "$envrc_state" == absent ]]; then
    printf '%s\n' "$full_block" >"$temp_file" || return 1
  elif [[ "$envrc_state" == managed ]]; then
    DENV_REPL="$full_block" awk -v start="$DENV_START_MARKER" -v end="$DENV_END_MARKER" '
      { line=$0; sub(/\r$/, "", line) }
      line == start { print ENVIRON["DENV_REPL"]; skip=1; next }
      line == end { skip=0; next }
      !skip { print }
    ' "$envrc_file" >"$temp_file" || return 1
  else
    cat -- "$envrc_file" >"$temp_file" || return 1
    if [[ -s "$temp_file" && -n "$(tail -c 1 "$temp_file")" ]]; then
      printf '\n' >>"$temp_file" || return 1
    fi
    printf '%s\n' "$full_block" >>"$temp_file" || return 1
  fi
  if [[ -f "$envrc_file" ]]; then preserve_file_mode "$envrc_file" "$temp_file" || return 1; fi
  mv -f -- "$temp_file" "$envrc_file" || return 1
  temp_file=""
  log_success "Wrote denv configuration to '${envrc_file}'."
}

remove_denv_block() {
  local envrc_file="$1" workspace_dir
  workspace_dir="$(dirname -- "$envrc_file")" || return 1
  temp_file="$(mktemp "${workspace_dir}/.envrc.tmp.XXXXXXXXXX")" || return 1
  awk -v start="$DENV_START_MARKER" -v end="$DENV_END_MARKER" '
    { line=$0; sub(/\r$/, "", line) }
    line == start { skip=1; next }
    line == end { skip=0; next }
    !skip { print }
  ' "$envrc_file" >"$temp_file" || return 1
  if [[ ! -s "$temp_file" ]] || ! grep -q '[^[:space:]]' "$temp_file"; then
    rm -f -- "$temp_file" "$envrc_file" || return 1
  else
    preserve_file_mode "$envrc_file" "$temp_file" || return 1
    mv -f -- "$temp_file" "$envrc_file" || return 1
  fi
  temp_file=""
}

exclude_in_git() {
  local workspace_dir="$1"
  local exclude_file=""

  if ! command -v git >/dev/null 2>&1; then
    log_warn "'git' is not installed or available in PATH; skipping --git-exclude."
    return 0
  fi

  if ! git -C "$workspace_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    log_warn "'${workspace_dir}' is not a git repository; skipping --git-exclude."
    return 0
  fi

  local raw_path
  raw_path="$(git -C "$workspace_dir" rev-parse --git-path info/exclude 2>/dev/null || true)"
  if [[ -n "$raw_path" ]]; then
    if [[ "$raw_path" = /* ]]; then
      exclude_file="$raw_path"
    else
      exclude_file="${workspace_dir}/${raw_path}"
    fi
  fi

  if [[ -n "$exclude_file" ]]; then
    local exclude_dir
    exclude_dir="$(dirname -- "$exclude_file")"
    if [[ ! -d "$exclude_dir" ]]; then
      mkdir -p -- "$exclude_dir" 2>/dev/null || true
    fi

    if [[ -d "$exclude_dir" ]] && [[ -w "$exclude_dir" || ( -f "$exclude_file" && -w "$exclude_file" ) ]]; then
      touch -- "$exclude_file"
      if [[ -s "$exclude_file" && -n "$(tail -c 1 "$exclude_file")" ]]; then
        printf '\n' >> "$exclude_file"
      fi
      local pattern
      for pattern in ".env" ".env.*" "!.env.example" ".envrc" ".envrc.bak" ".envrc.tmp.*" ".denv.lock/" ".denv.lock.recovery/" ".venv/" "venv/" ".conda/" ".pixi/"; do
        if ! grep -Fxq "$pattern" "$exclude_file" 2>/dev/null; then
          printf '%s\n' "$pattern" >> "$exclude_file"
        fi
      done
      log_success "Registered local artifacts in '${exclude_file}'."
      return 0
    fi
  fi

  log_warn "Git info/exclude is not writable; skipping --git-exclude."
}

# --- CLI commands ---

# One parser defines shared options, target handling and -- semantics for all
# commands. Command implementations receive state rather than reparse argv.
cli_target="."
cli_backend=auto
cli_force=false
cli_no_create=false
cli_git_exclude=false
cli_no_allow=false
cli_quiet=false

parse_options() {
  local command="$1" target_seen=false
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-color) init_colors never; shift ;;
      -h|--help) "usage_${command}"; exit "$EX_OK" ;;
      -v|--version) printf '%s version %s\n' "$SCRIPT_NAME" "$VERSION"; exit "$EX_OK" ;;
      -b|--backend)
        [[ "$command" == init && $# -ge 2 && -n "$2" && "$2" != -* ]] || { log_error "Option '$1' requires a backend for init."; exit "$EX_USAGE"; }
        cli_backend="$2"; shift 2 ;;
      -f|--force|-n|--no-create|-g|--git-exclude|--no-allow)
        [[ "$command" == init ]] || { log_error "Option '$1' is only valid for init."; exit "$EX_USAGE"; }
        case "$1" in
          -f|--force) cli_force=true ;;
          -n|--no-create) cli_no_create=true ;;
          -g|--git-exclude) cli_git_exclude=true ;;
          --no-allow) cli_no_allow=true ;;
        esac
        shift ;;
      -q|--quiet)
        [[ "$command" == status ]] || { log_error "Option '$1' is only valid for status."; exit "$EX_USAGE"; }
        cli_quiet=true; shift ;;
      --) shift; break ;;
      -*) log_error "Unknown option for '${command}': $1"; exit "$EX_USAGE" ;;
      *)
        [[ "$target_seen" == false ]] || { log_error "Unexpected argument: $1"; exit "$EX_USAGE"; }
        cli_target="$1"; target_seen=true; shift ;;
    esac
  done
  if [[ $# -gt 0 && "$target_seen" == false ]]; then cli_target="$1"; shift; fi
  [[ $# -eq 0 ]] || { log_error "Unexpected positional argument: $1"; exit "$EX_USAGE"; }
}

validate_writable_workspace() {
  if [[ ! -w "$target_dir" ]]; then
    log_error "Target directory '${target_dir}' is not writable."
    exit "$EX_NO_PERM"
  fi
  if [[ "${EUID:-$(id -u)}" -eq 0 && "${DENV_ALLOW_ROOT:-0}" != 1 ]]; then
    log_error "Refusing to run as root (set DENV_ALLOW_ROOT=1 to override)."
    exit "$EX_NO_PERM"
  fi
}

authorize_workspace() {
  if [[ "$cli_no_allow" == false ]]; then
    direnv allow "${target_dir}/.envrc"
    log_success "Workspace authorized via 'direnv allow'."
  else
    log_info "Configuration written without authorization (--no-allow); review .envrc, then run direnv allow."
  fi
}

cmd_init() {
  validate_backend "$cli_backend"
  validate_writable_workspace
  require_direnv
  acquire_lock "$target_dir"
  local envrc_file="${target_dir}/.envrc"
  validate_envrc_for_write "$envrc_file"
  if [[ "$envrc_state" == managed && "$cli_force" == false ]]; then
    log_info "Workspace is already configured (use --force to regenerate)."
  else
    build_activation_snippet "$target_dir" "$cli_backend" "$cli_no_create"
    apply_to_envrc "$envrc_file" "$activation_snippet" "$target_dir" "$cli_force"
  fi
  if [[ "$cli_git_exclude" == true ]]; then exclude_in_git "$target_dir"; fi
  authorize_workspace
}

# Decode only validated hexadecimal metadata, never eval shell code from .envrc.
read_managed_metadata() {
  local file="$1" field="$2"
  awk -v start="$DENV_START_MARKER" -v end="$DENV_END_MARKER" -v prefix="# denv ${field}: " '
    { line=$0; sub(/\r$/, "", line) }
    line == start { inside=1; next }
    line == end { inside=0 }
    inside && index(line, prefix) == 1 { print substr(line, length(prefix)+1); exit }
  ' "$file"
}

decode_environment() {
  local hex="$1" escaped=""
  [[ -n "$hex" && "$hex" != *[!0-9a-f]* && $((${#hex} % 2)) == 0 ]] || return 1
  while [[ -n "$hex" ]]; do
    [[ "${hex:0:2}" != 00 ]] || return 1
    escaped="${escaped}\\x${hex:0:2}"
    hex="${hex:2}"
  done
  printf '%b' "$escaped"
}

workspace_is_authorized() {
  command -v direnv >/dev/null 2>&1 || return 1
  # Consume all output: grep -q can close the pipe before direnv finishes,
  # making pipefail report SIGPIPE even when the authorization line matched.
  (cd -- "$1" && LC_ALL=C direnv status) 2>/dev/null | grep -E '^Found RC allowed (true|0)$' >/dev/null
}

cmd_status() {
  local envrc_file="${target_dir}/.envrc" ready=false authorized=false
  local backend="unknown" environment="" source="configuration" environment_state="not found"
  inspect_envrc "$envrc_file"
  if [[ "$envrc_state" == managed ]]; then
    backend="$(read_managed_metadata "$envrc_file" backend)"
    environment="$(decode_environment "$(read_managed_metadata "$envrc_file" environment)" || true)"
    # Local environments retain a relative fallback when the workspace moves.
    case "$backend" in
      uv|venv|local-existing)
        if [[ -f "${target_dir}/.venv/bin/activate" ]]; then environment="${target_dir}/.venv"
        elif [[ -f "${target_dir}/venv/bin/activate" && "$backend" == local-existing ]]; then environment="${target_dir}/venv"; fi ;;
    esac
    case "$backend" in
      conda|pixi) if [[ -d "${environment}/conda-meta" ]]; then ready=true; fi ;;
      uv|venv|local-existing|poetry|pipenv|pdm|hatch) if [[ -n "$environment" && -f "${environment}/bin/activate" ]]; then ready=true; fi ;;
      *) backend="unknown (run denv init --force)" ;;
    esac
    if [[ "$ready" == true ]]; then environment_state=exists; fi
    if workspace_is_authorized "$target_dir"; then authorized=true; fi
  else
    detect_workspace "$target_dir"
    backend="$detected_backend"; source="$detected_source"
    if [[ -f "${target_dir}/.venv/bin/activate" ]]; then environment="${target_dir}/.venv"; environment_state=exists
    elif [[ -f "${target_dir}/venv/bin/activate" ]]; then environment="${target_dir}/venv"; environment_state=exists; fi
  fi
  if [[ "$cli_quiet" == false ]]; then
    printf '\ndenv workspace status: %s\n\n' "$target_dir"
    printf '  %-20s %s (%s)\n' "Backend:" "${backend:-unknown}" "$source"
    printf '  %-20s %s\n' "Virtual env:" "${environment:-unknown} (${environment_state})"
    printf '  %-20s %s\n' ".envrc:" "$envrc_state"
    printf '  %-20s %s\n' "Authorized:" "$authorized"
    if [[ -f "${target_dir}/.env" ]]; then
      local count
      count="$(grep -cE '^(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=' "${target_dir}/.env" || true)"
      printf '  %-20s present (%s variables)\n' ".env:" "${count:-0}"
    else printf '  %-20s not present\n' ".env:"; fi
    local pyver
    if pyver="$(read_python_version "$target_dir")"; then printf '  %-20s %s\n' "Python version:" "$pyver"; fi
    if [[ -e "${target_dir}/.denv.lock" || -L "${target_dir}/.denv.lock" ]]; then
      local pid
      pid="$(cat "${target_dir}/.denv.lock/pid" 2>/dev/null || true)"
      printf '  %-20s present (PID %s)\n' "Lock:" "${pid:-unknown}"
    else printf '  %-20s none\n' "Lock:"; fi
    printf '\n'
  fi
  [[ "$envrc_state" == managed && "$ready" == true && "$authorized" == true ]]
}

revoke_workspace_authorization() {
  # Older direnv versions return an error if the current content has no
  # allow entry. Check first, but propagate real failures of deny.
  if [[ -f "${target_dir}/.envrc" ]] && workspace_is_authorized "$target_dir"; then
    direnv deny "${target_dir}/.envrc" || return 1
  fi
}

cmd_clean() {
  validate_writable_workspace
  acquire_lock "$target_dir"
  local envrc_file="${target_dir}/.envrc"
  validate_envrc_for_write "$envrc_file"
  if [[ "$envrc_state" == managed ]]; then
    if command -v direnv >/dev/null 2>&1; then
      revoke_workspace_authorization
    fi
    remove_denv_block "$envrc_file"
    # Custom content may have been authorized before denv was appended.
    if command -v direnv >/dev/null 2>&1; then
      revoke_workspace_authorization
      log_success "Revoked direnv authorization."
    fi
    log_success "Removed denv configuration (custom content and environments preserved)."
  else
    log_info "No denv block found; workspace is already clean."
  fi
}

main() {
  local command=init arg
  init_colors auto
  # Error messages also honor a later --no-color, without altering option values.
  for arg in "$@"; do
    [[ "$arg" != -- ]] || break
    if [[ "$arg" == --no-color ]]; then init_colors never; fi
  done
  while [[ "${1:-}" == --no-color ]]; do shift; done
  case "${1:-}" in
    -h|--help|help) usage_global; return 0 ;;
    -v|--version|version) printf '%s version %s\n' "$SCRIPT_NAME" "$VERSION"; return 0 ;;
    init|status|clean) command="$1"; shift ;;
  esac
  parse_options "$command" "$@"
  target_dir="$(resolve_target_dir "$cli_target")"
  "cmd_${command}"
}

main "$@"
